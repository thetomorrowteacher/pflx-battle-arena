{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/preview.html"
    },
    {
      "source": "/creator.html",
      "destination": "/public/creator.html"
    },
    {
      "source": "/games/:path*",
      "destination": "/public/games/:path*"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/public/vendor/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/public/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}